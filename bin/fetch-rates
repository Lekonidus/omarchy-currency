#!/usr/bin/env python3
"""Fetch Frankfurter JSON with end-to-end wall-clock and byte ceilings.

Exits non-zero on deadline, HTTP/network errors, or response overflow so the
shell only parses a successfully bounded body.

urllib's per-operation socket timeout alone is not enough: a slow-drip peer
can keep resetting that timer. SIGALRM enforces one deadline for connect +
headers + the entire body read.
"""
from __future__ import annotations

import signal
import sys
import urllib.request

LIMIT = 65536
TIMEOUT = 8


class DeadlineExceeded(Exception):
    pass


def _on_alarm(_signum, _frame) -> None:
    raise DeadlineExceeded("currency: wall-clock deadline exceeded")


def main() -> int:
    if len(sys.argv) != 2 or not sys.argv[1]:
        print("usage: fetch-rates <url>", file=sys.stderr)
        return 2

    url = sys.argv[1]
    req = urllib.request.Request(
        url,
        headers={"User-Agent": "omarchy-currency/1.0", "Accept": "application/json"},
        method="GET",
    )

    signal.signal(signal.SIGALRM, _on_alarm)
    signal.setitimer(signal.ITIMER_REAL, TIMEOUT)
    try:
        # Socket timeout is a per-op fallback; the alarm is the hard deadline.
        with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
            chunks: list[bytes] = []
            total = 0
            while True:
                block = resp.read(4096)
                if not block:
                    break
                total += len(block)
                if total > LIMIT:
                    print(
                        f"currency: response exceeds {LIMIT} byte limit",
                        file=sys.stderr,
                    )
                    return 3
                chunks.append(block)
    except DeadlineExceeded as exc:
        print(str(exc), file=sys.stderr)
        return 4
    except Exception as exc:  # noqa: BLE001 — surface any fetch failure to QML
        print(f"currency: fetch failed: {exc}", file=sys.stderr)
        return 1
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)

    sys.stdout.buffer.write(b"".join(chunks))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130) from None
