#!/usr/bin/env python3
"""Fetch Frankfurter JSON with wall-clock and stdout byte ceilings.

Exits non-zero on timeout, HTTP/network errors, or response overflow so the
shell only parses a successfully bounded body.
"""
from __future__ import annotations

import sys
import urllib.error
import urllib.request

LIMIT = 65536
TIMEOUT = 8


def main() -> int:
    if len(sys.argv) != 2 or not sys.argv[1]:
        print("usage: fetch-rates <url>", file=sys.stderr)
        return 2

    url = sys.argv[1]
    req = urllib.request.Request(
        url,
        headers={"User-Agent": "omarchy-currency/1.0", "Accept": "application/json"},
        method="GET",
    )

    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
            chunks: list[bytes] = []
            total = 0
            while True:
                block = resp.read(4096)
                if not block:
                    break
                total += len(block)
                if total > LIMIT:
                    print(
                        f"currency: response exceeds {LIMIT} byte limit",
                        file=sys.stderr,
                    )
                    return 3
                chunks.append(block)
    except Exception as exc:  # noqa: BLE001 — surface any fetch failure to QML
        print(f"currency: fetch failed: {exc}", file=sys.stderr)
        return 1

    sys.stdout.buffer.write(b"".join(chunks))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130) from None
